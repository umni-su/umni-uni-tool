{
  "name": "umni-uni",
  "version": "1.2.0-beta",
  "private": true,
  "type": "module",
  "links": {
    "site": "https://umni.su",
    "docs": "https://docs.umni.su",
    "api": "https://docs.umni.su/books/prosivka-umni-uni/page/rest-api-v10"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "tauri": "tauri",
    "updates": "npx npm-check-updates -u",
    "update:check": "ncu",
    "update:interactive": "ncu -i",
    "update:patch": "ncu -u --target patch && npm install --legacy-peer-deps",
    "update:minor": "ncu -u --target minor && npm install --legacy-peer-deps",
    "update:latest": "ncu -u --target latest && npm install --legacy-peer-deps",
    "update:full": "npm run update:clean && npm run update:latest",
    "update:clean": "rimraf node_modules package-lock.json",
    "update:reinstall": "npm run update:clean && npm install --legacy-peer-deps"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/cli": "^2.12.4",
    "@tauri-apps/plugin-http": "^2.8.3",
    "@tauri-apps/plugin-notification": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-store": "^2.5.0",
    "axios": "^1.21.0",
    "echarts": "^6.1.0",
    "moment": "^2.31.0",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.4.0",
    "vuex": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.12.0",
    "sass-embedded": "^1.107.0",
    "vite": "^8.3.5",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vite-plugin-vuetify": "^2.1.3",
    "vuetify": "^4.3.1"
  }
}
